ges_settings_settingspage", "callee": "encodeURIComponent", "is_member_call": false, "source_file": "C:\\Users\\tvonh\\Desktop\\getforgenta\\backups\\2026-05-13_010739\\src\\pages\\Settings.tsx", "source_location": "L742"}, {"caller_nid": "pages_settings_settingspage", "callee": "encodeURIComponent", "is_member_call": false, "source_file": "C:\\Users\\tvonh\\Desktop\\getforgenta\\backups\\2026-05-13_010739\\src\\pages\\Settings.tsx", "source_location": "L781"}, {"caller_nid": "pages_settings_settingspage", "callee": "encodeURIComponent", "is_member_call": false, "source_file": "C:\\Users\\tvonh\\Desktop\\getforgenta\\backups\\2026-05-13_010739\\src\\pages\\Settings.tsx", "source_location": "L781"}, {"caller_nid": "pages_settings_settingspage", "callee": "(() => {\r\n            const provider = subscription?.purchase_provider;\r\n            // Block only if actively renewing \u2014 cancel_at_period_end means no future charge risk\r\n            const hasMobileSub = isPremium && (provider === 'apple' || provider === 'google') && !subscription?.cancel_at_period_end;\r\n            const storeLabel = provider === 'apple' ? 'App Store' : 'Google Play';\r\n            const storeSteps = provider === 'apple'\r\n              ? 'Settings \u2192 [your name] \u2192 Subscriptions \u2192 Forgenta \u2192 Cancel'\r\n              : 'Play Store \u2192 Profile \u2192 Payments & subscriptions \u2192 Subscriptions \u2192 Forgenta \u2192 Cancel';\r\n\r\n            return (\r\n              <div className=\"flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between\">\r\n                <div>\r\n                  <p className=\"text-xs font-medium\">Delete Account</p>\r\n                  <p className=\"text-xs text-muted-foreground mt-0.5\">\r\n                    {hasMobileSub\r\n                      ? 'You must cancel your active subscription before deleting your account.'\r\n                      : 'Permanently deletes your account and all data. Active subscriptions are cancelled immediately. Billing records are retained per IRS requirements.'}\r\n                  </p>\r\n                  {hasMobileSub && (\r\n                    <div className=\"mt-2 flex items-start gap-2 bg-amber-500/10 border border-amber-500/30 px-3 py-2.5 text-xs text-amber-600\" style={{ borderRadius: 'var(--radius)' }}>\r\n                      <Crown size={13} className=\"mt-0.5 shrink-0 text-amber-500\" />\r\n                      <span>\r\n                        You have an active <strong>{storeLabel} subscription</strong>. Cancel it first to avoid further charges, then return here to delete your account.\r\n                        <br />\r\n                        <span className=\"text-amber-500/80 mt-1 block\">{storeSteps}</span>\r\n                      </span>\r\n                    </div>\r\n                  )}\r\n                </div>\r\n                <button\r\n                  onClick={() => !hasMobileSub && setDeleteStep('confirm')}\r\n                  disabled={hasMobileSub}\r\n                  className=\"shrink-0 flex items-center gap-1.5 bg-secondary border border-destructive/30 text-destructive px-3 py-1.5 text-xs font-medium hover:bg-destructive/10 transition-colors btn-press disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-secondary\"\r\n                  style={{ borderRadius: 'var(--radius)' }}\r\n                >\r\n                  <Trash2 size={12} />\r\n                  Delete account\r\n                </button>\r\n              </div>\r\n            );\r\n          })", "is_member_call": false, "source_file": "C:\\Users\\tvonh\\Desktop\\getforgenta\\backups\\2026-05-13_010739\\src\\pages\\Settings.tsx", "source_location": "L796"}, {"caller_nid": "pages_settings_settingspage", "callee": "format", "is_member_call": false, "source_file": "C:\\Users\\tvonh\\Desktop\\getforgenta\\backups\\2026-05-13_010739\\src\\pages\\Settings.tsx", "source_location": "L919"}, {"caller_nid": "pages_settings_settingspage"