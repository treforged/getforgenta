<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Associated Domains for Universal Links (email confirmation opening the native app).

  Wired into Debug and Release via CODE_SIGN_ENTITLEMENTS in project.pbxproj.
  Associated Domains is enabled on App ID com.treforged.forged and the "Forged App Store"
  provisioning profile was regenerated with it on 2026-07-27. Release signs Manual against
  that pinned profile, so the BUILD_PROVISION_PROFILE_BASE64 GitHub secret must carry the
  REGENERATED profile or the iOS build will fail at signing.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:getforgenta.com</string>
	</array>
</dict>
</plist>
