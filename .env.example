# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Supabase — get these from: https://supabase.com/dashboard/project/<id>/settings/api
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Cloudflare Turnstile — get site key from: https://dash.cloudflare.com/ → Turnstile
# Secret key goes in Supabase Edge Function secrets as TURNSTILE_SECRET_KEY (never here)
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY_HERE

# LaunchDarkly Observability — web desktop only, never runs on native iOS/Android
# This is the error tracker AND the session replay recorder. Replays are
# recorded with privacySetting 'strict' (all text, inputs, images and video
# redacted) because this app renders real balances — see src/lib/monitoring.ts.
# Unset it and error reporting/replay silently no-op; the app still works.
# Get client ID from: https://app.launchdarkly.com → Observability → Projects
VITE_LD_CLIENT_ID=YOUR_LD_CLIENT_ID_HERE

# Exposes /__error-test, a route that crashes ON PURPOSE, to prove errors reach
# the dashboard with a readable stack and a replay attached. Always on in dev.
# Set to 1 on a PREVIEW deploy to prove the production path (minified bundle
# resolved through source maps), then unset it. Never leave it on in production.
VITE_ENABLE_ERROR_TEST=

# Google Analytics 4 — Measurement ID (Admin → Data streams → Forgenta Web). Real value in Vercel env. Web-only; no-ops on native / when unset.
VITE_GA_MEASUREMENT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Account aggregation
# ─────────────────────────────────────────────────────────────────────────────
# Plaid OAuth redirect. Must be whitelisted in the Plaid dashboard
# (Team Settings → API → Allowed redirect URIs). Leave unset to disable
# OAuth-only banks (Chase, BoA, etc.).
VITE_PLAID_OAUTH_REDIRECT_URI=

# Akoya (fallback aggregator) has NO frontend variables by design. The client
# never sees a client id, secret, or connector — it sends an institution slug to
# the akoya-auth-url edge function and receives a ready-made authorization URL.
#
# Set these as Supabase Edge Function secrets instead
# (Dashboard → Edge Functions → Secrets):
#
#   AKOYA_CLIENT_ID           From the Akoya Data Recipient Hub
#   AKOYA_CLIENT_SECRET       From the Hub. Never expose to the client.
#   AKOYA_REDIRECT_URI        https://getforgenta.com/akoya-oauth
#                             Must match the Hub registration exactly.
#   AKOYA_ENV                 sandbox | production   (defaults to sandbox)
#   AKOYA_CONNECTOR_FIDELITY  Fidelity's connector id, from the Hub's
#                             Data providers tab. Differs between sandbox and
#                             production. Without it the Fidelity fallback
#                             returns 503 rather than guessing.
#   TOKEN_ENC_KEY             32 random bytes, base64. Encrypts Akoya refresh
#                             tokens at rest. Generate with:
#                               openssl rand -base64 32
#                             Rotating this invalidates every stored Akoya
#                             connection — users would have to reconnect.
